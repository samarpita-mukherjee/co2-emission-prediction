   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Macro F1: 0.5278894954092653\n",
      "Weighted F1: 0.5215725537168722\n"
     ]
    }
   ],
   "source": [
    "print(\"Macro F1:\",\n",
    "      f1_score(y_test_c, y_pred_c, average='macro'))\n",
    "\n",
    "print(\"Weighted F1:\",\n",
    "      f1_score(y_test_c, y_pred_c, average='weighted'))\n",
    "\n",
    "# The macro f1 score calculates the f1 score for each of the 7 classes and then averages them. The weighted f1 calculates the f1 score for each group \n",
    "# but weights these according to the size of the group. In this case they are very similar (0.528 vs 0.522).\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 38,
   "id": "6271ec1c-e317-4a84-97f0-096317a8acf5",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Within one class: 0.9611736157070373\n",
      "Percentage: 96.11736157070374 %\n",
      "MAE: 0.5045223913523054\n"
     ]
    }
   ],
   "source": [
    "# As the groups are in size order it would be useful to know what percentage of vehicles are either correctly classified or within one classification \n",
    "# either side. It would also be good to have an idea of how the Mean Average Error, ie how for off the data is on average in classications.\n",
    "\n",
    "y_true_num = y_test_c.astype(int).to_numpy()\n",
    "y_pred_num = np.asarray(y_pred_c).astype(int)\n",
    "\n",
    "within_one = np.mean(\n",
    "    np.abs(y_true_num - y_pred_num) <= 1\n",
    ")\n",
    "\n",
    "print(\"Within one class:\", within_one)\n",
    "print(\"Percentage:\", within_one * 100, \"%\")\n",
    "\n",
    "print(\"MAE:\", mean_absolute_error(y_test_c, y_pred_c))\n",
    "\n",
    "# 96% of the data is either correctly classified or just one class away. The predictions are on average about half a class out from the correct class."
   ]
  },
